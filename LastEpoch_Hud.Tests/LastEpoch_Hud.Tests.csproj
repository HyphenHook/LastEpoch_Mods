<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <!-- Game-independent mod code. Il2Cpp types here fail to compile on purpose. -->
    <Compile
      Include="..\LastEpoch_Hud\Core\**\*.cs"
      Link="Mod\Core\%(RecursiveDir)%(Filename)%(Extension)"
    />
    <Compile Include="..\LastEpoch_Hud\Application\Runtime\**\*.cs" Link="Mod\Application\Runtime\%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="..\LastEpoch_Hud\Infrastructure\Persistence\**\*.cs" Exclude="..\LastEpoch_Hud\Infrastructure\Persistence\Configuration\**\*.cs" Link="Mod\Infrastructure\Persistence\%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="..\LastEpoch_Hud\Application\Testing\**\*.cs" Link="Mod\Application\Testing\%(RecursiveDir)%(Filename)%(Extension)" />
    <Using Include="Xunit" />
    <None Include="KnownIssues.txt" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Locales\KeepEnglish.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Iced" Version="1.21.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.10.1" />
    <PackageReference Include="Mono.Cecil" Version="0.11.6" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.0">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="xunit.v3" Version="4.0.1" />
  </ItemGroup>
</Project>
